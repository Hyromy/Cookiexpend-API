# ------------------------------------------------------------------------------
#                           GENERAL SETTINGS
# ------------------------------------------------------------------------------
# Enable/Disable production mode
PRODUCTION=False
# Secret key used for signing cookies and tokens
DJANGO_SECRET_KEY=

# ------------------------------------------------------------------------------
#                           NETWORKING & SECURITY
# ------------------------------------------------------------------------------
# Allowed hostnames for the application
HOSTS=
# Allowed origins for Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED=
# Trusted origins for CSRF protection
CSRF_TRUSTED=
# Domain name for session cookies (without leading dot in production)
SESSION_DOMAIN=
# Whether to force HTTPS/SSL redirects and secure cookies
USE_SSL=False

# ------------------------------------------------------------------------------
#                           DATABASE SETTINGS (PostgreSQL)
# ------------------------------------------------------------------------------
# Name of the database
DB_NAME=
# Database user name
DB_USER=
# Database password
DB_PASS=
# Database server host
DB_HOST=
# Database server port
DB_PORT=

# ------------------------------------------------------------------------------
#                           REDIS / CACHE SETTINGS
# ------------------------------------------------------------------------------
# Connection URL for Redis (used for events/gossiper.py and caching)
REDIS_URL=
